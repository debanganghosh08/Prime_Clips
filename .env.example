# Prime Clips settings. Copy to `.env` (in the folder you run primeclips from)
# and uncomment what you want to change. Every line below shows the default.
#
# Keep comments on their own line: the .env loader does not strip inline comments.
# Leave a variable commented out rather than empty; an empty value overrides the default.

# ---------------------------------------------------------------- paths / ffmpeg
# Where clips, replay buffers and downloads live (Docker image sets this to /data).
# PRIMECLIPS_DATA_DIR=data
# ffmpeg / ffprobe binary names or full paths.
# PRIMECLIPS_FFMPEG=ffmpeg
# PRIMECLIPS_FFPROBE=ffprobe

# ---------------------------------------------------------------- replay buffer
# Length of each buffer segment, in seconds.
# PRIMECLIPS_SEGMENT_SECONDS=2.0
# How many minutes of the live stream to keep on disk.
# PRIMECLIPS_BUFFER_MINUTES=10.0
# Stream quality passed to streamlink / yt-dlp.
# PRIMECLIPS_QUALITY=best

# ---------------------------------------------------------------- rendering
# auto | libx264 | h264_nvenc | h264_qsv | h264_amf
# PRIMECLIPS_ENCODER=auto
# Threads for the x264 encoder and caption transcription.
# PRIMECLIPS_THREADS=2
# Run ffmpeg and helper processes at below-normal priority (true/false).
# PRIMECLIPS_LOW_PRIORITY=true
# Output frame rate of rendered shorts. Use "source" to keep the original fps.
# PRIMECLIPS_RENDER_FPS=30
# Facecam rectangle for the "gaming" layout: x,y,w,h as fractions of the source frame.
# PRIMECLIPS_FACECAM=0,0,0.28,0.30

# ---------------------------------------------------------------- session defaults
# vertical-blur | crop | gaming | landscape
# PRIMECLIPS_LAYOUT=vertical-blur
# Auto-clip when the hype score passes the threshold (true/false).
# PRIMECLIPS_AUTO_CLIP=true
# Hype score (0-100) that triggers an auto clip. Lower = more clips.
# PRIMECLIPS_THRESHOLD=70
# Seconds kept before and after the trigger moment.
# PRIMECLIPS_PRE=25
# PRIMECLIPS_POST=8
# Minimum seconds between two auto clips.
# PRIMECLIPS_COOLDOWN=45
# Read live chat as a hype signal (true/false).
# PRIMECLIPS_CHAT=true
# Burn word-by-word captions (needs faster-whisper; costs CPU and seconds).
# PRIMECLIPS_CAPTIONS=false
# faster-whisper model name.
# PRIMECLIPS_WHISPER_MODEL=base

# ---------------------------------------------------------------- AI titles (optional)
# Any OpenAI-compatible endpoint. Both BASE_URL and MODEL must be set to enable it.
# Ollama:     http://localhost:11434/v1               model e.g. llama3.2
# OpenRouter: https://openrouter.ai/api/v1             model e.g. google/gemini-2.5-flash
# Gemini:     https://generativelanguage.googleapis.com/v1beta/openai   model e.g. gemini-2.5-flash
# PRIMECLIPS_LLM_BASE_URL=
# PRIMECLIPS_LLM_API_KEY=
# PRIMECLIPS_LLM_MODEL=

# ---------------------------------------------------------------- titles / publishing
# Fallback title. Placeholders: {channel} {reason}
# PRIMECLIPS_TITLE_TEMPLATE={channel} {reason} 😱
# Appended to Discord / YouTube posts.
# PRIMECLIPS_HASHTAGS=#shorts #gaming #clips
# Discord webhook URL for instant clip pings.
# PRIMECLIPS_DISCORD_WEBHOOK=
# Post every finished clip to Discord automatically (true/false).
# PRIMECLIPS_DISCORD_AUTO=false
# EXPERIMENTAL: path to your Google OAuth client_secrets.json for YouTube Shorts upload.
# PRIMECLIPS_YOUTUBE_CLIENT_SECRETS=
# EXPERIMENTAL: privacy status for uploaded Shorts (public / unlisted / private).
# PRIMECLIPS_YOUTUBE_PRIVACY=public
